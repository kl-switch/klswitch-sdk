{
  "id": "load-invalid-rule",
  "description": "Single rule uses unsupported operator bogus_op at compile time; load returns structured error, zero compiled rules (first load on empty engine).",
  "fixture_kind": "scenario",
  "steps": [
    {
      "op": "load_rules",
      "ruleset": {
        "schema_version": "1.0",
        "rules_version": 1,
        "rules": [
          {
            "id": "bad_operator_rule",
            "name": "Invalid operator rule",
            "selector": {
              "kind": "api",
              "keys": {
                "method": "GET",
                "path": "/compliance/v1/load-invalid"
              }
            },
            "enabled": true,
            "priority": 10,
            "condition": {
              "all": [
                {
                  "field": "body.x",
                  "operator": "bogus_op",
                  "value": 1
                }
              ]
            },
            "action": {
              "type": "block",
              "payload": {}
            }
          }
        ]
      },
      "expected_load_rules_result": {
        "ok": false,
        "rules_version": 1,
        "rule_count": 1,
        "compiled_rule_count": 0,
        "skipped_rule_count": 1,
        "errors": [
          {
            "code": "INVALID_OPERATOR",
            "message": "Rule uses an operator that is not supported in v1.",
            "rule_id": "bad_operator_rule",
            "field": "condition.operator"
          }
        ]
      }
    }
  ]
}
