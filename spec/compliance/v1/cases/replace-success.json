            "enabled": true,
            "priority": 100,
            "condition": {
              "all": [
                {
                  "field": "body.phase",
                  "operator": "eq",
                  "value": "beta"
                }
              ]
            },
            "action": {
              "type": "route",
              "payload": {
                "tag": "v2"
              }
            }
          }
        ]
      },
      "expected_load_rules_result": {
        "ok": true,
        "rules_version": 20,
        "rule_count": 1,
        "compiled_rule_count": 1,
        "skipped_rule_count": 0,
        "errors": []
