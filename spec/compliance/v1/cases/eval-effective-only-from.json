{
  "id": "eval-effective-only-from",
  "description": "One-sided window with only a start bound (from=1000, no end); now=5000 is after the start so the rule stays active indefinitely and matches.",
  "ruleset": {
    "schema_version": "1.0",
    "rules_version": 1,
    "rules": [
      {
        "id": "block_from_only",
        "name": "Active from a start time",
        "selector": { "kind": "api", "keys": { "method": "POST", "path": "/v1/orders" } },
        "enabled": true,
        "priority": 100,
        "effective": { "from": 1000 },
        "condition": { "all": [{ "field": "body.a", "operator": "exists" }] },
        "action": { "type": "block", "payload": { "statusCode": 403 } }
      }
    ]
  },
  "evaluation_input": {
    "selector": { "kind": "api", "keys": { "method": "POST", "path": "/v1/orders" } },
    "facts": { "headers": {}, "query": {}, "params": {}, "body": { "a": 1 }, "meta": {} },
    "now": 5000
  },
  "expected_evaluation_result": {
    "ok": true,
    "matched": [{ "id": "block_from_only", "name": "Active from a start time", "priority": 100, "action": { "type": "block", "payload": { "statusCode": 403 } } }],
    "evaluated": 1,
    "skipped": 0,
    "errors": []
  }
}
