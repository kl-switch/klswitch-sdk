{
  "id": "eval-pattern-trailing-matches-bare-prefix",
  "description": "Selector path /v1/** matches the bare prefix GET /v1 \u2014 `**` absorbs zero or more trailing segments (rule-model 8.1).",
  "ruleset": {
    "schema_version": "1.2",
    "rules_version": 1,
    "rules": [
      {
        "id": "pattern_subtree",
        "name": "Pattern subtree",
        "selector": {
          "kind": "api",
          "keys": {
            "method": "GET",
            "path": "/v1/**"
          }
        },
        "enabled": true,
        "priority": 100,
        "condition": {
          "all": [
            {
              "field": "body.amount",
              "operator": "gt",
              "value": 100
            }
          ]
        },
        "action": {
          "type": "block",
          "payload": {
            "statusCode": 403
          }
        }
      }
    ]
  },
  "evaluation_input": {
    "selector": {
      "kind": "api",
      "keys": {
        "method": "GET",
        "path": "/v1"
      }
    },
    "facts": {
      "headers": {},
      "query": {},
      "params": {},
      "body": {
        "amount": 5000
      },
      "meta": {}
    }
  },
  "expected_evaluation_result": {
    "ok": true,
    "matched": [
      {
        "id": "pattern_subtree",
        "name": "Pattern subtree",
        "priority": 100,
        "action": {
          "type": "block",
          "payload": {
            "statusCode": 403
          }
        }
      }
    ],
    "evaluated": 1,
    "skipped": 0,
    "errors": []
  }
}
